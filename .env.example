# Telegram Bot credentials (get token from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# Optional locally (automatically provided in GitHub Actions)
GITHUB_TOKEN=

# Optional URL to your GitHub Pages archive (linked at bottom of Telegram digest)
DIGEST_SITE_URL=https://your-username.github.io/news-update/

# Timezone offset in hours (UTC+04:00 = 4)
TIMEZONE_OFFSET_HOURS=4
